.tree-node { margin: 4rpx 0; }
.node-row {
  display: flex; align-items: center; gap: 14rpx;
  padding: 12rpx 16rpx; border-radius: 12rpx;
}
.node-row:active { background: #1a2340; }
.node-dot { width: 14rpx; height: 14rpx; border-radius: 50%; flex-shrink: 0; }
.node-name { font-size: 27rpx; color: #e2e8f0; }
.node-toggle { margin-left: auto; color: #8b98b8; font-size: 24rpx; }
